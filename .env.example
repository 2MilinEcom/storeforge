APP_URL=http://localhost:3000
APP_ENCRYPTION_KEY=
DEMO_MODE=true

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files,read_themes,write_themes,read_online_store_navigation,write_online_store_navigation,read_publications,write_publications

# Optional. StoreForge auto-detects Chrome/Chromium for visual QA.
CHROME_PATH=

# Automatic TikTok creator-video sourcing. StoreForge can bootstrap yt-dlp automatically.
AUTO_DOWNLOAD_YTDLP=true
YTDLP_PATH=
# Optional fallback for public posts that TikTok only serves to a logged-in browser, e.g. chrome.
# Leave blank unless you understand the browser-cookie implications.
YTDLP_COOKIES_FROM_BROWSER=
